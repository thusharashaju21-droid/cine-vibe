

# ========== USER CREATION =========== #

# api call for creating user
###
POST http://127.0.0.1:8000/film/register/
Content-Type: application/json

{
    "username":"userB",
    "email":"userB@gmail.com",
    "password":"userB123"
}

# api call for token authentication
###
POST http://127.0.0.1:8000/film/token/
Content-Type: application/json

{
    "username":"userB",
    "password":"userB123"
}


# ========== MOVIE LIST & CREATE =========== #

# api call for listing movies
###
GET http://127.0.0.1:8000/film/movie/
Accept: application/json
Authorization: Token b7ee31909cc37531f5f40bfe2330e69e34f3073f

# api call for creating movies
###
POST http://127.0.0.1:8000/film/movie/
Content-Type: application/json
Authorization: Token b7ee31909cc37531f5f40bfe2330e69e34f3073f

{
    "title":"jailer2",
    "language":"tamil",
    "release_year":2026,
    "duration":"3hr 10min",
    "rating":9.5
}

# ========== MOVIE RETRIEVE,UPDATE,DELETE =========== #


# api call for listing one movie
###
GET http://127.0.0.1:8000/film/movie/1/
Accept: application/json
Authorization: Token b7ee31909cc37531f5f40bfe2330e69e34f3073f

# api call for updating one movies
###
PUT http://127.0.0.1:8000/film/movie/1/
Content-Type: application/json
Authorization: Token b7ee31909cc37531f5f40bfe2330e69e34f3073f

{
  "id": 1,
  "owner": "userB",
  "title": "bethelem kudumba unit",
  "language": "malayalam",
  "release_year": 2026,
  "duration": "2hr 5min",
  "rating": "9",
  "created_at": "2026-10-22",
  "updated_at": "2026-10-26"
}

# api call for deleting one movie
###
DELETE http://127.0.0.1:8000/film/movie/5/
Accept: application/json
Authorization: Token b7ee31909cc37531f5f40bfe2330e69e34f3073f


