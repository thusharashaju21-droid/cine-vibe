# ========== REVIEW LIST,CREATE =========== #


# api call for listing reviews
###
GET http://127.0.0.1:8000/opinion/review/all/
Accept: application/json
Authorization: Token b7ee31909cc37531f5f40bfe2330e69e34f3073f

# api call for creating review
###
POST http://127.0.0.1:8000/opinion/movie/2/review/
Content-Type: application/json
Authorization: Token b7ee31909cc37531f5f40bfe2330e69e34f3073f

{
    "message":"nice",
    "rating":8
}


# ========== REVIEW RETRIEVE,UPDATE,DELETE =========== #

